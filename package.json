{
  "name": "motor-qa-web",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "import:planilha": "python tools/import_planilha.py",
    "sync:icons": "node -e \"require('fs').copyFileSync('fonte/util/loop.png','frontend/public/icons/reteste.png')\"",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "npm run start -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
