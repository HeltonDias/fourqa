# Copie para ".env" (ignorado pelo git) e preencha.
# Equivale a tabela tbScriptAzureDevOps da aba Config_Teste da planilha.

# Persistência. A API só sobe com postgres.
# sqlite permanece nos testes e no comando db:backup.
DB_PROVIDER=postgres
# Local: sessão ou conexão direta, como já está validada.
# Vercel: transaction pooler, porta 6543, copiado do Connect do Supabase. Não reuse a URL local sem testar.
DATABASE_URL=
# Na Vercel use o transaction pooler do Supabase (porta 6543), não a conexão direta.
# O host do pooler vem do botão Connect do projeto. Não monte o host à mão.
# TLS do PostgreSQL verifica o certificado do servidor, inclusive no Session Pooler.
# sslmode=require, verify-ca e verify-full conferem CA e hostname.
# sslmode=no-verify desliga essa verificação de propósito; não use no Supabase.
# Se o Node não confiar na CA, aponte para um PEM local e não versione o arquivo:
# DATABASE_SSL_CA_FILE=certs/supabase-ca.pem
DATABASE_SSL_CA_FILE=

AZURE_DEVOPS_ORG=sua-organizacao
AZURE_DEVOPS_PROJECT=Seu Projeto

# PAT com escopos: Test Management (Read) e Work Items (Read).
# NUNCA versionar, colar em codigo ou em logs.
AZURE_DEVOPS_PAT=
# ============================================================================
# Config_Teste da planilha "Status_Report_Diario_QA_SIAS_EndToEnd_Fase3"
# (tbScript*). Os JSONs abaixo ficam em UMA linha. Valores SIM/NAO como na planilha.
# ============================================================================

# --- tbScriptAzureDevOps (Organization, Project e PAT estão no topo do arquivo) ---
AZURE_DEVOPS_API_VERSION=7.1

# --- tbScriptTestPlans: PlanKey, PlanId, PlanName, SuiteNameFilter, MaxSuites, Carregar ---
SYNC_TEST_PLANS=[{"PlanKey":"EndToEnd","PlanId":86730,"PlanName":"SIAS - Fase 2 - EndToEnd","SuiteNameFilter":"","MaxSuites":0,"Carregar":"SIM"}]

# --- tbScriptHierarquiaSuites (OPCIONAL): override manual de um nível genérico.
# A árvore é detectada no sync. Confiança alta (ex.: "Prioridade 0") vence este mapeamento.
# Sem esta variável, níveis desconhecidos aparecem como "Nível 1", "Nível 2", ...
# PlanKey (opcional): aplica só ao plano indicado. Fonte: hierarchy_level (padrão) ou current_suite.
SYNC_HIERARQUIA_SUITES=[{"PlanKey":"MeuPlano","Ordem":1,"NomeColuna":"Frente","NivelOrigem":"1","Fonte":"hierarchy_level","Ativo":"SIM"},{"PlanKey":"MeuPlano","Ordem":2,"NomeColuna":"Processo","Fonte":"current_suite","Ativo":"SIM"}]

# --- tbScriptResponsabilidades: Categoria -> Responsabilidade ---
SYNC_RESPONSABILIDADES={"01. Dev. Backend":"Desenvolvimento Foursys","02. Dev. Frontend":"Desenvolvimento Foursys","03. Dev. Mobile":"Desenvolvimento Foursys","04. Dev. Identidade Visual":"Desenvolvimento Foursys","05. Change Request":"Cliente CVP","06. Infraestrutura/Ambiente":"Cliente CVP","07. Massa de Dados":"Cliente CVP","08. Erro de Execução do QA":"QA Foursys","09. Documentação":"Cliente CVP","10. Outros":"Outros"}

# --- tbScriptExecucoesDestino / tbScriptFalhasDestino ---
# AbaDestino/NomeTabela da planilha (Controle_Execusoes, Controle_Falhas) viram as tabelas
# "execucoes" e "falhas" do SQLite. LimparAntes=SIM (substitui tudo) e CriarCabecalho=SIM:
# o app só suporta SIM; qualquer outro valor interrompe a sincronização.
SYNC_LIMPAR_ANTES=SIM
SYNC_CRIAR_CABECALHO=SIM

# --- tbScriptExecucoesCampos / tbScriptFalhasCampos (referência) ---
# O banco usa sempre estas colunas; as listas abaixo só documentam a configuração da planilha.
SYNC_EXECUCOES_CAMPOS=PlanKey,PlanId,PlanName,Frente,Atalho,SuiteId,SuiteName,TestPointId,TestCaseId,TestCaseTitle,Responsabilidade,TestCaseState,TestPointState,Outcome,DateCompleted,RunBy,LastUpdatedDate,LastTestRunId,LastResultId,TestCaseLink,TestCaseTags
SYNC_FALHAS_CAMPOS=PlanKey,Responsavel,Ambiente,Categoria,ID,Impacto,Frente,Título,Status,Criação,Fechamento,Links,Tags

# --- Constantes dos Office Scripts ---
# Plano usado no cálculo dos KPIs da Home (C14:E14).
SYNC_KPI_PLAN_KEY=EndToEnd

# Origens do frontend permitidas no CORS, separadas por vírgula.
# Vazio = localhost:5173 e localhost:3001.
FRONTEND_ORIGIN=

# Se preenchido, POST /api/sync e as demais escritas exigem Authorization: Bearer <token>.
# O frontend lê o mesmo valor de localStorage "fourqa_token" (não vai no bundle).
# Vazio fecha a escrita. Desenvolvimento local sem token exige o opt-in abaixo.
FOURQA_API_TOKEN=
FOURQA_ALLOW_OPEN_WRITES=
# Vazio na API PostgreSQL local: execuções e falhas ficam no cache em memória.
# 0 grava o snapshot em execucoes/falhas. Na Vercel o vazio também grava no PostgreSQL.
# Não use 1 na Vercel: a aplicação recusa subir.
AZURE_CACHE_READ=
# PEM do CA, se o Node não confiar no certificado. Na Vercel use o conteúdo, não um caminho local.
# DATABASE_SSL_CA=
# FOURQA_PROTECT_READS=0 desliga a proteção de leitura só fora de um Preview real.
FOURQA_PROTECT_READS=
# FL_VALID_FRONTS (frentes reconhecidas nas tags dos bugs, na ordem de exibição).
SYNC_FRENTES_VALIDAS=GEATE,GEDEV,GEFEA,GEFIS,GEMCO,GERORJ,GERSA,GESIN
